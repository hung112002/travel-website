<%- include('partials/header', { title: 'お問い合わせ' }) %>

    <main class="jp-main">
        <section class="jp-hero">
            <div class="jp-hero-inner">
                <p class="jp-eyebrow">SHIMANE MESSAGE</p>
                <h1>お問い合わせ</h1>
                <p class="jp-lead">お気軽にお問い合わせください。<br>皆様からのご連絡をお待ちしております。</p>
                <div class="jp-stamp" aria-hidden="true">?</div>
            </div>
        </section>

        <section class="jp-contact-wrap">
            <div class="jp-contact-panel jp-reveal">
                <div class="jp-panel-header">
                    <h2>連絡先</h2>
                    <p>Shimane Travel Desk</p>
                </div>
                <div class="jp-panel-body">
                    <div class="jp-info-row">
                        <span class="jp-info-label">住所</span>
                        <span class="jp-info-value">島根県松江市1-2-3</span>
                    </div>
                    <div class="jp-info-row">
                        <span class="jp-info-label">営業時間</span>
                        <span class="jp-info-value">9:00 - 18:00</span>
                    </div>
                    <div class="jp-info-row">
                        <span class="jp-info-label">メール</span>
                        <span class="jp-info-value">info@shimane-travel.jp</span>
                    </div>
                    <div class="jp-info-row">
                        <span class="jp-info-label">電話番号</span>
                        <span class="jp-info-value">0852-00-0000</span>
                    </div>
                    <div class="jp-info-row">
                        <span class="jp-info-label">FAX</span>
                        <span class="jp-info-value">0852-00-0001</span>
                    </div>
                </div>
                <div class="jp-panel-footer">
                    <p>島根専門ITデザインカレッジ</p>
                </div>
            </div>

            <div class="jp-form-card jp-reveal" style="animation-delay: 0.1s;">
                <h2>お問い合わせフォーム</h2>

                <% if (typeof sent !== 'undefined' && sent) { %>
                    <div class="jp-success">お問い合わせが送信されました。ありがとうございました。</div>
                <% } %>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="jp-error"><%= error %></div>
                <% } %>

                <form class="jp-form" action="/contact" method="POST">
                    <div class="jp-form-grid">
                        <label>
                            お名前
                            <input type="text" name="name" placeholder="例: 山田 太郎" required>
                        </label>
                        <label>
                            メールアドレス
                            <input type="email" name="email" placeholder="example@mail.com" required>
                        </label>
                    </div>
                    <label>
                        件名
                        <input type="text" name="subject" placeholder="例: 質問/予約/その他" required>
                    </label>
                    <label>
                        メッセージ
                        <textarea name="message" rows="6" placeholder="ご用件を詳しくご記入ください" required></textarea>
                    </label>
                    <div class="jp-form-actions">
                        <span class="jp-note">※ 必須項目です</span>
                        <button type="submit" class="jp-btn">送信</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="jp-callout">
            <div class="jp-callout-inner">
                <h3>お問い合わせ</h3>
                <p>お気軽にご連絡ください。私たちは皆様の声を大切にしています。</p>
            </div>
        </section>
    </main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
